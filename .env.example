# .env.example - copy to .env and fill in your keys

# Required
DISCORD_TOKEN=
MONGO_URL=mongodb://yuri:yuri_local_dev_password@mongo:27017/yuri_bot_db?authSource=admin
OWNER_ID=                    # Your Discord user ID (integer)
GEMINI_API_KEY=

# Required for Groq fallback + voice transcription
GROQ_API_KEY=

# Optional - Groq key rotation
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional - Fine-tuned model via Together AI
TOGETHER_API_KEY=
FINETUNED_MODEL_NAME=

# Optional - Sentry error tracking (https://sentry.io)
SENTRY_DSN=

# Optional - Discord shard count (for large bots, >1000 servers)
# SHARD_COUNT=1
